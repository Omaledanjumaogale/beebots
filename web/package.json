{
  "name": "omiebot-ai-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/static-contract.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "convex:dev": "convex dev",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name omiebot-ai-trading && npm run verify:deployment",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.39.0",
    "@sveltejs/kit": "^2.48.0",
    "convex": "^1.28.0",
    "lightweight-charts": "^5.0.9",
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.43.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.15.0",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.47.0"
  }
}
